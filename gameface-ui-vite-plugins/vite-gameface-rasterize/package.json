{
  "name": "vite-gameface-rasterize",
  "version": "1.0.0",
  "type": "module",
  "description": "A Vite plugin that bakes expensive static CSS decorations into pre-rendered textures using the Gameface Player, so cohtml draws a textured quad instead of re-evaluating shadows, gradients and filters every frame.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "gameface-rasterize": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contract": {
      "types": "./dist/contract.d.ts",
      "import": "./dist/contract.js"
    }
  },
  "scripts": {
    "build": "npm run clean:dist&&rollup -c",
    "dev": "rollup -c -w",
    "publish:package": "npm run clean&&npm i&&rollup -c&&npm publish",
    "clean:dist": "rm -rf dist",
    "clean": "npm run clean:dist&&rm -rf node_modules&&rm package-lock.json"
  },
  "keywords": [
    "vite-plugin",
    "gameface",
    "cohtml",
    "coherent-labs",
    "rasterize",
    "9-slice",
    "performance"
  ],
  "author": "CoherentLabs",
  "license": "ISC",
  "dependencies": {
    "chrome-remote-interface": "^0.34.0",
    "sharp": "^0.34.0"
  },
  "peerDependencies": {
    "vite": ">=5"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/chrome-remote-interface": "^0.33.0",
    "@types/node": "^22.13.14",
    "rollup": "^4.38.0",
    "tslib": "^2.8.1",
    "typescript": "^5.8.2",
    "vite": "^5.4.10"
  }
}
