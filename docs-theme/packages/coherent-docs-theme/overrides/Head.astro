---
import DefaultHead from '@astrojs/starlight/components/Head.astro';
import getThemeConfig from '../internal/themeConfig';
import { buildStructuredData, toScriptJson } from '../internal/structuredData';

const { webMcp = true, structuredData = true } = getThemeConfig();

const currentProduct = import.meta.env.DOCS_PRODUCT || "Gameface";
const productName = currentProduct.charAt(0).toUpperCase() + currentProduct.slice(1);

const productNameRegex = /<ProductName\s*\/?>|<ProductName>\s*<\/ProductName>/gi;

const routeData = Astro.locals.starlightRoute ?? Astro.props;

if (Array.isArray(routeData?.head)) {
    routeData.head.forEach((tag) => {
        if (tag.tag === 'title' && typeof tag.content === 'string') {
            tag.content = tag.content.replace(productNameRegex, productName);
        }

        if (tag.tag === 'meta' && typeof tag.attrs?.content === 'string') {
            const isTargetMeta = 
                tag.attrs.name === 'description' || 
                tag.attrs.property === 'og:title' || 
                tag.attrs.property === 'og:description' ||
                tag.attrs.name === 'twitter:title' ||
                tag.attrs.name === 'twitter:description';

            if (isTargetMeta) {
                tag.attrs.content = tag.attrs.content.replace(productNameRegex, productName);
            }
        }
    });
}

// Schema.org JSON-LD. Needs absolute URLs (the config's `site`); none on the 404 page.
const formatLabel = (text: string) => String(text ?? '').replace(productNameRegex, productName);
const isNotFound = routeData?.entry?.id === '404' || /\/404\/?$/.test(Astro.url.pathname);
const jsonLd = structuredData && Astro.site && routeData?.entry?.data && !isNotFound
    ? toScriptJson(buildStructuredData(
        {
            url: new URL(Astro.url.pathname, Astro.site).href,
            root: new URL(import.meta.env.BASE_URL, Astro.site).href,
            siteTitle: formatLabel(routeData.siteTitle ?? ''),
            title: formatLabel(routeData.entry.data.title ?? ''),
            description: routeData.entry.data.description ? formatLabel(routeData.entry.data.description) : undefined,
            lang: routeData.lang,
            lastUpdated: routeData.lastUpdated instanceof Date ? routeData.lastUpdated : undefined,
            sidebar: routeData.sidebar,
            formatLabel,
        },
        typeof structuredData === 'object' ? structuredData : {},
    ))
    : undefined;
---

<DefaultHead {...Astro.props} />
{jsonLd && <script is:inline type="application/ld+json" set:html={jsonLd} />}
{webMcp && (
    <script>
        import "../internal/webMcp";
    </script>
)}