---
// Consolidated, hand-rolled search UI built directly on Pagefind's raw JS API (no
// @astrojs/starlight/components/Search.astro, no @pagefind/default-ui PagefindUI). We fork
// Starlight's small, stable "site-search" modal shell (open/close, Ctrl+K, dialog, translations)
// and replace everything downstream of it with our own documentation -> engine -> type filter
// hierarchy and result renderer, so we're never fighting someone else's re-renders again.
import { Icon } from "@astrojs/starlight/components";
import project from "virtual:starlight/project-context";

import getThemeConfig from "../internal/themeConfig";
import {
    siteRegistry,
    getMergeIndexesFor,
    getEnginesForDocumentation,
} from "../internal/siteRegistry";

const { documentation, engine, tagManagerId } = getThemeConfig();
const isDev = import.meta.env.DEV;
const baseUrl =
    import.meta.env.BASE_URL === "/" ? "" : import.meta.env.BASE_URL;

const DOCUMENTATION_VALUES = [
    ...new Set(
        [...siteRegistry.map((s) => s.documentation), documentation].filter(
            Boolean,
        ),
    ),
];
const ENGINE_VALUES = [
    ...new Set([
        ...siteRegistry.filter((s) => s.engine).map((s) => s.engine as string),
        ...(engine ? [engine] : []),
    ]),
];

const DOCUMENTATION_ENGINES: Record<string, string[]> = Object.fromEntries(
    DOCUMENTATION_VALUES.map((doc) => {
        const engines = new Set(getEnginesForDocumentation(doc));
        if (doc === documentation && engine) engines.add(engine);
        return [doc, [...engines]];
    }),
);

const mergeIndexes = getMergeIndexesFor(documentation, engine);

const pagefindTranslations = {
    placeholder: Astro.locals.t("search.label"),
    ...Object.fromEntries(
        Object.entries(Astro.locals.t.all())
            .filter(([key]) => key.startsWith("pagefind."))
            .map(([key, value]) => [key.replace("pagefind.", ""), value]),
    ),
};

const searchConfig = {
    documentation: documentation || null,
    engine: engine || null,
    tagManagerId: tagManagerId || null,
    baseUrl,
    isDev,
    mergeIndexes,
    documentationValues: DOCUMENTATION_VALUES,
    engineValues: ENGINE_VALUES,
    documentationEngines: DOCUMENTATION_ENGINES,
};

const dataAttributes: Record<string, string> = {
    "data-translations": JSON.stringify(pagefindTranslations),
    "data-config": JSON.stringify(searchConfig),
};
if (project.trailingSlash === "never")
    dataAttributes["data-strip-trailing-slash"] = "";
---

<site-search class={Astro.props.class} {...dataAttributes}>
    <button
        data-open-modal
        disabled
        aria-label={Astro.locals.t("search.label")}
        aria-keyshortcuts="Control+K"
    >
        <Icon name="magnifier" />
        <span class="sl-hidden md:sl-block" aria-hidden="true"
            >{Astro.locals.t("search.label")}</span
        >
        <kbd class="sl-hidden md:sl-flex" style="display: none;">
            <kbd>{Astro.locals.t("search.ctrlKey")}</kbd>+<kbd>K</kbd>
        </kbd>
    </button>

    <dialog style="padding:0" aria-label={Astro.locals.t("search.label")}>
        <div class="coh-loading-bar" aria-hidden="true">
            <div class="coh-loading-bar-inner"></div>
        </div>
        <div class="dialog-frame sl-flex">
            {
                isDev ? (
                    <div
                        style="margin: auto; text-align: center; white-space: pre-line;"
                        dir="ltr"
                    >
                        <p>{Astro.locals.t("search.devWarning")}</p>
                    </div>
                ) : (
                    <div class="search-container">
                        <div id="coherent-search">
                            <div class="search-form-wrapper">
                                <form
                                    class="coh-form"
                                    role="search"
                                    aria-label={Astro.locals.t("search.label")}
                                    action="javascript:void(0);"
                                >
                                    <input
                                        type="text"
                                        class="coh-input"
                                        placeholder={Astro.locals.t(
                                            "search.label",
                                        )}
                                        autocomplete="off"
                                    />
                                    <button
                                        type="button"
                                        class="coh-clear"
                                        aria-label="Clear"
                                    >
                                        ✕
                                    </button>
                                </form>
                                <button
                                    data-close-modal
                                    class="sl-flex md:sl-hidden"
                                >
                                    {Astro.locals.t("search.cancelLabel")}
                                </button>
                            </div>
                            <details class="coh-filters">
                                <summary>
                                    <Icon
                                        name="right-caret"
                                        class="caret"
                                        size="1.25rem"
                                    />
                                    Filters
                                </summary>
                                <div class="filters-wrapper">
                                    <div class="coh-filter-group">
                                        <span class="coh-filter-label">
                                            Documentation:
                                        </span>
                                        <div
                                            class="coh-filter-tier"
                                            data-tier="documentation"
                                            role="group"
                                            aria-label="Documentation"
                                        />
                                    </div>
                                    <div
                                        class="coh-filter-group coh-filter-group--engine"
                                        data-tier-group="engine"
                                        hidden
                                    >
                                        <span class="coh-filter-label">
                                            Engine:
                                        </span>
                                        <div
                                            class="coh-filter-tier"
                                            data-tier="engine"
                                            role="group"
                                            aria-label="Engine"
                                        />
                                    </div>
                                    <div
                                        class="coh-filter-group"
                                        data-tier-group="type"
                                        hidden
                                    >
                                        <span class="coh-filter-label">
                                            Content type:
                                        </span>
                                        <div
                                            class="coh-filter-tier"
                                            data-tier="type"
                                            role="group"
                                            aria-label="Content type"
                                        />
                                    </div>
                                    <div class="coh-filter-group">
                                        <span class="coh-filter-label">
                                            Exact match
                                        </span>
                                        <div class="coh-filter-tier">
                                            <input
                                                type="checkbox"
                                                class="coh-filter-btn coh-exact-match-toggle"
                                                aria-pressed="false"
                                            />
                                        </div>
                                    </div>
                                </div>
                            </details>
                            <p class="coh-message" aria-live="polite" />
                            <p
                                class="coh-refining-indicator"
                                aria-live="polite"
                                hidden
                            >
                                Looking for more exact matches…
                            </p>
                            <ul class="coh-results" />
                            <button type="button" class="coh-load-more" hidden>
                                Load more results
                            </button>
                        </div>
                    </div>
                )
            }
        </div>
        <button
            type="button"
            title="Back to top"
            class="coh-back-to-top"
            aria-label="Back to top"
            hidden
        >
            <Icon name="up-caret" />
        </button>
    </dialog>
</site-search>

<script is:inline>
    (() => {
        const openBtn = document.querySelector("button[data-open-modal]");
        const shortcut = openBtn?.querySelector("kbd");
        if (!openBtn || !(shortcut instanceof HTMLElement)) return;
        const platformKey = shortcut.querySelector("kbd");
        if (platformKey && /(Mac|iPhone|iPod|iPad)/i.test(navigator.platform)) {
            platformKey.textContent = "⌘";
            openBtn.setAttribute("aria-keyshortcuts", "Meta+K");
        }
        shortcut.style.display = "";
    })();
</script>

<script>
    import "../internal/searchClient";
</script>

<style>
    @layer starlight.core {
        site-search {
            display: contents;
        }
        button[data-open-modal] {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            border: 0;
            background-color: transparent;
            color: var(--sl-color-gray-1);
            cursor: pointer;
            height: 2.5rem;
            font-size: var(--sl-text-xl);
        }

        @media (min-width: 50rem) {
            button[data-open-modal] {
                border: 1px solid var(--sl-color-gray-5);
                border-radius: 0.5rem;
                padding-inline-start: 0.75rem;
                padding-inline-end: 0.5rem;
                background-color: var(--sl-color-black);
                color: var(--sl-color-gray-2);
                font-size: var(--sl-text-sm);
                width: 100%;
                max-width: 22rem;
            }
            button[data-open-modal]:hover {
                border-color: var(--sl-color-gray-2);
                color: var(--sl-color-white);
            }

            button[data-open-modal] > :last-child {
                margin-inline-start: auto;
            }
        }

        button > kbd {
            border-radius: 0.25rem;
            border: 0.1rem solid var(--sl-color-gray-5);
            font-size: var(--sl-text-2xs);
            gap: 0.25em;
            padding-inline: 0.375rem;
            background-color: var(--sl-color-gray-6);
        }

        kbd {
            font-family: var(--__sl-font);
        }

        dialog {
            position: relative;
            margin: 0;
            background-color: var(--sl-color-gray-6);
            border: 1px solid var(--sl-color-gray-5);
            width: 100%;
            max-width: 100%;
            height: 100%;
            max-height: 100%;
            box-shadow: var(--sl-shadow-lg);
        }
        dialog[open] {
            display: flex;
        }

        dialog::backdrop {
            background-color: var(--sl-color-backdrop-overlay);
            -webkit-backdrop-filter: blur(0.25rem);
            backdrop-filter: blur(0.25rem);
        }

        .dialog-frame {
            position: relative;
            overflow: auto;
            flex-direction: column;
            flex-grow: 1;
            gap: 1rem;
            padding: 1rem;
        }

        button[data-close-modal] {
            position: relative;
            z-index: 1;
            align-items: center;
            align-self: flex-end;
            height: 64px;
            padding: 0.25rem;
            border: 0;
            background: transparent;
            cursor: pointer;
            color: var(--sl-color-text-accent);
        }

        @media (min-width: 50rem) {
            dialog {
                margin: 4rem auto auto;
                border-radius: 0.5rem;
                width: 90%;
                max-width: 40rem;
                height: max-content;
                min-height: 15rem;
                max-height: calc(100% - 8rem);
            }

            .dialog-frame {
                padding: 1.5rem;
            }
        }
    }
</style>

<style is:global>
    @media (min-width: 50rem) {
        site-search dialog {
            max-width: 90%;
        }
    }

    [data-search-modal-open] {
        overflow: hidden;
    }

    #coherent-search {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .coh-form {
        position: relative;
        flex: 1 0 auto;
    }

    .search-form-wrapper {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .coh-input {
        width: 100%;
        padding: 0.65rem 2.5rem 0.65rem 0.85rem;
        border-radius: 0.5rem;
        border: 1px solid var(--sl-color-gray-5);
        background-color: var(--sl-color-black);
        color: var(--sl-color-white);
        font-size: var(--sl-text-base);
    }

    .coh-input:focus {
        outline: 2px solid var(--sl-color-accent);
        outline-offset: -1px;
    }

    .coh-clear {
        position: absolute;
        inset-inline-end: 0.5rem;
        top: 50%;
        transform: translateY(-50%);
        background: transparent;
        border: 0;
        color: var(--sl-color-gray-3);
        cursor: pointer;
        display: none;
        padding: 0.25rem;
    }

    .coh-clear--visible {
        display: inline-flex;
    }

    .coh-loading-bar {
        position: absolute;
        width: 100%;
        height: 2px;
        border-radius: 999px;
        overflow: hidden;
        background: transparent;
        opacity: 0;
        transition: opacity 0.15s ease;
        z-index: 10;
    }

    .coh-loading-bar--active {
        opacity: 1;
    }

    .coh-loading-bar-inner {
        position: absolute;
        top: 0;
        left: -35%;
        height: 100%;
        width: 35%;
        border-radius: 999px;
        background: linear-gradient(
            90deg,
            transparent,
            var(--sl-color-accent),
            transparent
        );
    }

    .coh-loading-bar--active .coh-loading-bar-inner {
        animation: coh-loading-slide 1.1s ease-in-out infinite;
    }

    @keyframes coh-loading-slide {
        0% {
            left: -35%;
        }
        100% {
            left: 100%;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .coh-loading-bar-inner {
            animation: none !important;
            left: 0;
            width: 100%;
            opacity: 0.6;
        }
    }

    .coh-filters {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .coh-filters > summary {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        cursor: pointer;
        user-select: none;
    }

    .coh-filters .caret {
        transition: transform 0.2s ease-in-out;
        flex-shrink: 0;
    }
    .coh-filters[open] > summary .caret {
        transform: rotateZ(90deg);
    }

    .coh-filters::marker {
        display: none;
    }

    .filters-wrapper {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        padding-inline-start: 1.8rem;
    }

    .coh-filter-group {
        display: flex;
        flex-direction: row;
        gap: 0.75rem;
        align-items: center;
        flex-wrap: wrap;
        margin-bottom: 0.5rem;
    }

    .coh-filter-group[hidden] {
        display: none;
    }

    .coh-filter-label {
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--sl-color-gray-3);
    }

    .coh-filter-tier {
        display: flex;
        flex-wrap: wrap;
        gap: 0.3rem;
    }

    .coh-filter-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        padding: 0.4rem 1rem;
        font-size: 0.85rem;
        font-weight: 600;
        background-color: var(--sl-color-bg-nav);
        border: 1px solid var(--sl-color-gray-5);
        color: var(--sl-color-gray-3);
        border-radius: 999px;
        user-select: none;
        transition: all 0.2s ease;
    }

    .coh-filter-btn:disabled {
        cursor: not-allowed;
        opacity: 0.6;
    }

    .coh-filter-btn:hover {
        filter: brightness(1.2);
        opacity: 1;
        color: var(--sl-color-black);
        background: var(--sl-color-text-accent);
    }

    .coh-filter-btn--active {
        background-color: var(--sl-color-accent);
        border-color: var(--sl-color-accent);
        color: var(--gameface-bg-main, #fff);
    }

    .coh-message {
        margin: 0;
        color: var(--sl-color-gray-3);
        font-size: 0.9rem;
    }

    .coh-refining-indicator {
        margin: 0;
        color: var(--sl-color-gray-4);
        font-size: 0.8rem;
        font-style: italic;
    }

    .coh-results {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
    }

    .coh-result {
        display: flex;
        flex-direction: column;
    }

    .coh-result-link,
    .coh-result-sub {
        display: block;
        text-decoration: none;
        color: inherit;
        background-color: var(--sl-color-black);
        border-radius: 0.3125rem;
        border: 1px solid transparent;
        transition: border-color 0.2s ease;
    }

    .coh-result-link:hover,
    .coh-result-link:focus-within,
    .coh-result-sub:hover,
    .coh-result-sub:focus-within {
        border-color: var(--sl-color-accent);
    }

    .coh-result-link {
        padding: 0.9375rem 1.25rem;
        color: var(--sl-color-white);
    }

    .coh-result-title {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.5rem;
        margin: 0;
        font-weight: 600;
    }

    .coh-result-badge {
        color: white;
        padding: 2px 8px;
        border-radius: 12px;
        font-size: 11px;
        font-weight: bold;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        white-space: nowrap;
    }

    .coh-result-excerpt,
    .coh-result-sub-excerpt {
        margin: 0.25rem 0 0;
        color: var(--sl-color-gray-2);
        font-size: 1rem;
        overflow-wrap: anywhere;
    }

    .coh-result-excerpt mark,
    .coh-result-sub-excerpt mark {
        font-weight: 900;
        background-color: rgba(255, 215, 0, 0.3);
        color: var(--sl-color-white);
        padding: 0 2px;
        border-radius: 2px;
    }

    .coh-result-sub {
        margin-top: 0.625rem;
        padding: 0.625rem 1.25rem;
        margin-inline-start: 2.25rem;
        border-left: 0.3rem solid var(--sl-color-gray-5);
    }

    .coh-result-sub-link {
        display: block;
        color: var(--sl-color-white);
        font-weight: 600;
    }

    .coh-load-more {
        align-self: center;
        padding: 0.5rem 1.5rem;
        border-radius: 0.5rem;
        border: 1px solid var(--sl-color-gray-5);
        background-color: var(--sl-color-bg-nav);
        color: var(--sl-color-white);
        cursor: pointer;
    }

    .coh-load-more:hover {
        border-color: var(--sl-color-accent);
    }

    .coh-load-more:disabled {
        cursor: not-allowed;
        opacity: 0.6;
    }

    .coh-load-more:disabled:hover {
        border-color: var(--sl-color-gray-5);
    }

    .coh-back-to-top {
        position: absolute;
        right: 1rem;
        bottom: 1rem;
        z-index: 2;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 2.5rem;
        height: 2.5rem;
        border-radius: 999px;
        border: 1px solid var(--sl-color-gray-5);
        background-color: var(--sl-color-bg-nav);
        color: var(--sl-color-white);
        font-size: 1.1rem;
        line-height: 1;
        cursor: pointer;
        box-shadow: var(--sl-shadow-md);
    }

    .coh-back-to-top:hover {
        border-color: var(--sl-color-accent);
    }

    .coh-back-to-top[hidden] {
        display: none;
    }
</style>
